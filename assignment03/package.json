{
  "name": "assemblyscript-benchmark",
  "version": "1.0.0",
  "description": "WebAssembly mit AssemblyScript: Einstiegsbeispiel und Laufzeitvergleich mit JavaScript",
  "private": true,
  "type": "module",
  "scripts": {
    "build:hello": "asc assembly/hello.ts -o build/hello.wasm -t build/hello.wat -O3 --bindings esm",
    "build:benchmark": "asc assembly/benchmark.ts -o build/benchmark.wasm -O3 --bindings esm",
    "build": "npm run build:hello && npm run build:benchmark",
    "hello": "node examples/hello.mjs",
    "bench": "node bench.mjs",
    "start": "node server.mjs"
  },
  "devDependencies": {
    "assemblyscript": "^0.28.20"
  }
}
